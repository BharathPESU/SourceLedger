# SourceLedger — Environment Configuration Template
# Copy to `.env` and fill in real values. Never commit `.env` itself.

# ── Proxy / Multimodal OCR Gateway API ────────────────────────────────
API_URL="https://free-api-erel.onrender.com/api/generate"
API_KEY="your_api_proxy_key_here"

# ── LLM API Keys (Round-Robin Rotator) ────────────────────────────────
# Use one or more Google Gemini API keys for round-robin rate-limit avoidance
GOOGLE_API_KEY1=your_google_api_key_1_here
GOOGLE_API_KEY2=your_google_api_key_2_here
GOOGLE_API_KEY3=your_google_api_key_3_here
GOOGLE_API_KEY4=your_google_api_key_4_here
GOOGLE_API_KEY5=your_google_api_key_5_here
GOOGLE_API_KEY6=your_google_api_key_6_here
GOOGLE_API_KEY7=your_google_api_key_7_here
GOOGLE_API_KEY8=your_google_api_key_8_here

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sourceledger:sourceledger@localhost:5432/sourceledger

# ── Vector DB ────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ── App Settings ─────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# Fields with confidence below this threshold route to the review queue
# instead of being auto-committed. Range: 0–100.
CONFIDENCE_THRESHOLD=70

# ── Storage ──────────────────────────────────────────────────────────
# Local path for storing original source documents (PDFs, HTML snapshots)
SOURCE_STORAGE_PATH=./storage/sources

# ── Supabase Authentication Configuration ──────────────────────────────
# Obtain your Project URL and Publishable/Anon API key from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
