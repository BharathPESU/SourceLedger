# SourceLedger — Environment Configuration
# Copy to .env and fill in real values. Never commit .env itself.

# ── LLM API ──────────────────────────────────────────────────────────
# Use one of the following (Gemini is the primary choice per architecture.md)
GOOGLE_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here

# ── Gemini API Gateway Proxy Settings ─────────────────────────────────
# GEMINI_PROXY_URL=http://localhost:8000
# PROXY_AUTH_TOKEN=your-proxy-auth-token-here

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sourceledger:sourceledger@localhost:5432/sourceledger

# ── Vector DB (stretch — Phase 5 only) ───────────────────────────────
QDRANT_URL=http://localhost:6333

# ── App Settings ─────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# Fields with confidence below this threshold route to the review queue
# instead of being auto-committed. Range: 0–100.
CONFIDENCE_THRESHOLD=70

# ── Storage ──────────────────────────────────────────────────────────
# Local path for storing original source documents (PDFs, HTML snapshots)
SOURCE_STORAGE_PATH=./storage/sources
